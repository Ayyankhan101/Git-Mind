.vercel
node_modules
build

backend/venv/
backend/__pycache__/
backend/optimized/
backend/analyses/
backend/gitmind.db

# Runtime caches and persist dirs. Matched anywhere under the tree, not just at
# backend/ — a module that moves into a subpackage must never be able to drop
# a 30k-line model blob somewhere git is still watching.
**/.chroma/
**/.chroma_registry.json
**/.fastembed_cache/
**/.llm_cache/
**/.dspy_harvest/
**/__pycache__/
*.pyc
graphify-out/
graphify-out.zip

# Opencode context (internal)
.opencode/

# Screenshots and captures
*.jpg
*.png
screenshot-*
capture-*

# Rust sidecar build artifacts
rust-sidecar/target/

# Frontend build output
frontend/dist/

# Lighthouse CI artifacts
frontend/.lighthouseci/

# OS files
.DS_Store

# Backup files
*.bak

# Local LLM model files (large, downloaded locally)
*.gguf
.env*

# Frontend coverage
frontend/coverage/

# Duplicate agent skills
agent/

# Skills lock file
skills-lock.json

# CI's `cp -r rust-gitmind backend/` deploy step output — never source, only
# ever produced at build time (see .github/workflows/ci.yml)
backend/rust-gitmind/

# Claude Code session-lock state (churns every session, not project state)
.claude/scheduled_tasks.lock

# Freebuff desktop app's local project marker (unrelated tool, not ours)
.freebuff/

# Tool caches — these self-ignore via their own inner .gitignore, but listing
# them here keeps `git status --ignored` readable.
.mypy_cache/
.pytest_cache/
.ruff_cache/
.serena/
.gstack/
.superpowers/
