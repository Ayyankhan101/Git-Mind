GROQ_API_KEY=gsk_...
# GITHUB_TOKEN=ghp_...   (optional — raises GitHub API rate limit 60→5000 req/hr)
# WS_AUTH_SECRET=...      (optional — if set, WS clients must send matching ws_auth_secret in payload)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://your-app.vercel.app   (default: covers all localhost; add Vercel domain in production)
# DATABASE_URL=sqlite+aiosqlite:///./gitmind.db   (default — SQLite for local dev)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gitmind   (production)
# REDIS_URL=redis://localhost:6379/0   (optional — enables Redis for rate limiting, sessions, task queue; falls back to in-memory if unset)
# SENTRY_DSN=https://...@sentry.io/...   (optional — enables error tracking; no-op if unset)
# ENVIRONMENT=production   (optional — used by Sentry and health checks)
# REQUIRE_WS_AUTH=false   (optional — when true, WebSocket connections require gh_token in payload)
# GITMIND_SERVICE_KEY=...   (optional — CI service key for /webhook/notify, /task/*, /analysis/previous)
# TASK_WORKERS=3   (optional — number of background task workers)
