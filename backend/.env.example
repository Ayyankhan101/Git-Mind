# GitMind backend — environment template
# Copy to `.env` and fill in the values:
#   cp .env.example .env
# Required secrets are marked [REQUIRED]; everything else is optional and has
# a documented default in backend/README.md → "Optional environment variables".

# ── Required secrets ─────────────────────────────────────────────────────────

# Groq API key (gsk_...) — the app won't start without it.
GROQ_API_KEY=

# Comma-separated allowed CORS origins, e.g. https://gitmind-frontend.pages.dev
CORS_ORIGINS=

# Hugging Face token with write access — used by CI to upload the Space.
HF_TOKEN=

# ── LLM / optimization ───────────────────────────────────────────────────────

# Groq model used by all agents (default: qwen/qwen3.6-27b).
# LLM_MODEL=qwen/qwen3.6-27b

# Same-provider fallback model, tried automatically if LLM_MODEL fails
# (deprecation, rate-limit) — default: llama-3.1-8b-instant. Set to an empty
# string to disable.
# LLM_MODEL_FALLBACK=llama-3.1-8b-instant

# Remaining daily token window, in tokens, that the MIPROv2 self-optimization
# budget guard should enforce (see backend/optimization/budget.py). The Groq
# on-demand tier caps at 100_000 tokens/day; set this to whatever the Groq
# console reports as left today so `optimization.run` aborts before a compile
# would exceed it. Unset or 0 disables the guard (unguarded manual deep-tuning
# only — a full `auto="light"` compile burns tens of thousands of tokens).
# You can also pass it per-run via `--budget N`.
# GROQ_DAILY_REMAINING=100000

# ── GitHub / auth ────────────────────────────────────────────────────────────

# GitHub PAT — raises API rate limits for repo cloning (60 → 5 000 req/hr).
GITHUB_TOKEN=

# CI/CD auth key — bypasses rate limits.
GITMIND_SERVICE_KEY=

# GitHub App credentials (webhook-based flows).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_WEBHOOK_SECRET=

# GitHub OAuth App credentials ("Sign in with GitHub" — NOT the GitHub App
# above; a different credential type registered on a different GitHub
# settings page: Settings → Developer settings → OAuth Apps). Its
# Authorization callback URL must exactly equal
# OAUTH_REDIRECT_BASE_URL + "/auth/github/callback". Unset = the sign-in
# button 503s; the manual paste-your-PAT flow is unaffected either way.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Backend's own public URL, used to build the redirect_uri sent to GitHub.
# OAUTH_REDIRECT_BASE_URL=https://ak001z-gitmind-backend.hf.space
# Frontend origin the browser lands back on after sign-in.
# OAUTH_FRONTEND_URL=https://gitmind-frontend.pages.dev

# ── Persistence ──────────────────────────────────────────────────────────────

# SQLAlchemy async URL. Default: sqlite+aiosqlite:///./gitmind.db
# Production: postgresql+asyncpg://user:pass@host:5432/gitmind
DATABASE_URL=

# Redis connection — enables persistent rate-limiter, session cache, task
# queue, and GitHub OAuth sign-in (which hard-requires it).
REDIS_URL=

# When "true", the rate limiter/session store/Redis client fail closed
# instead of falling back to per-process memory when Redis is down. Off by
# default so single-process deployments without Redis keep working.
# REQUIRE_REDIS=false

# Switch RAG vector search from embedded ChromaDB to a Qdrant sidecar —
# needed once you run more than one backend worker/replica. Unset = ChromaDB.
# QDRANT_URL=http://localhost:6333

# S3-compatible bucket for caching shallow-clone bundles by repo+SHA (avoids
# re-cloning the same commit for a repeat PR-impact run or an org-audit that
# overlaps an already-analyzed repo). Unset = no clone cache, clones fresh
# every time (today's behavior).
# CLONE_CACHE_BUCKET=
# CLONE_CACHE_ENDPOINT_URL=   # for Cloudflare R2 / MinIO / non-AWS S3-compatible stores

# ── Observability ────────────────────────────────────────────────────────────

# Sentry DSN for error tracking.
SENTRY_DSN=

# Environment tag for Sentry (`production`, `staging`).
ENVIRONMENT=

# OpenTelemetry OTLP gRPC endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enable JSON structured logging (`1`).
JSON_LOGS=

# Logging level (default: INFO).
LOG_LEVEL=

# Enable health check debug info.
DEBUG=

# ── WebSocket ────────────────────────────────────────────────────────────────

# WebSocket auth secret — when set, clients must send matching
# ws_auth_secret + ws_auth_ts (replay-protected). Unset = WS auth disabled.
WS_AUTH_SECRET=

# ── Runtime tuning ───────────────────────────────────────────────────────────

# Solidity parser sidecar endpoint (default: http://127.0.0.1:8003).
SIDECAR_URL=

# Background queue worker count (default: 3).
TASK_WORKERS=

# Repo monitoring loop interval in seconds (default: 3600).
MONITOR_INTERVAL_SECONDS=

# Max request body size in bytes (default: 5 MB).
MAX_REQUEST_BODY_BYTES=

# Reranker model for RAG (default: cross-encoder/ms-marco-MiniLM-L-6-v2).
RERANKER_MODEL=

# SMTP for email sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend (set at Cloudflare Pages build time) ───────────────────────────

# Public backend URL the React frontend points at (no trailing slash).
REACT_APP_API_BASE=https://ak001z-gitmind-backend.hf.space
