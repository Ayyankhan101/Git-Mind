# GitMind backend — environment template
# Copy to `.env` and fill in the values:
#   cp .env.example .env
# Required secrets are marked [REQUIRED]; everything else is optional and has
# a documented default in backend/README.md → "Optional environment variables".

# ── Required secrets ─────────────────────────────────────────────────────────

# Groq API key (gsk_...) — the app won't start without it.
GROQ_API_KEY=

# Comma-separated allowed CORS origins, e.g. https://gitmind-peach.vercel.app
CORS_ORIGINS=

# Hugging Face token with write access — used by CI to upload the Space.
HF_TOKEN=

# ── LLM / optimization ───────────────────────────────────────────────────────

# Groq model used by all agents (default: llama-3.3-70b-versatile).
# LLM_MODEL=llama-3.3-70b-versatile

# Remaining daily token window, in tokens, that the MIPROv2 self-optimization
# budget guard should enforce (see backend/optimization/budget.py). The Groq
# on-demand tier caps at 100_000 tokens/day; set this to whatever the Groq
# console reports as left today so `optimization.run` aborts before a compile
# would exceed it. Unset or 0 disables the guard (unguarded manual deep-tuning
# only — a full `auto="light"` compile burns tens of thousands of tokens).
# You can also pass it per-run via `--budget N`.
# GROQ_DAILY_REMAINING=100000

# ── GitHub / auth ────────────────────────────────────────────────────────────

# GitHub PAT — raises API rate limits for repo cloning (60 → 5 000 req/hr).
GITHUB_TOKEN=

# CI/CD auth key — bypasses rate limits.
GITMIND_SERVICE_KEY=

# GitHub App credentials (webhook-based flows).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_WEBHOOK_SECRET=

# ── Persistence ──────────────────────────────────────────────────────────────

# SQLAlchemy async URL. Default: sqlite+aiosqlite:///./gitmind.db
# Production: postgresql+asyncpg://user:pass@host:5432/gitmind
DATABASE_URL=

# Redis connection — enables persistent rate-limiter, session cache, task queue.
REDIS_URL=

# ── Observability ────────────────────────────────────────────────────────────

# Sentry DSN for error tracking.
SENTRY_DSN=

# Environment tag for Sentry (`production`, `staging`).
ENVIRONMENT=

# OpenTelemetry OTLP gRPC endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Enable JSON structured logging (`1`).
JSON_LOGS=

# Logging level (default: INFO).
LOG_LEVEL=

# Enable health check debug info.
DEBUG=

# ── WebSocket ────────────────────────────────────────────────────────────────

# WebSocket auth secret — when set, clients must send matching
# ws_auth_secret + ws_auth_ts (replay-protected). Unset = WS auth disabled.
WS_AUTH_SECRET=

# ── Runtime tuning ───────────────────────────────────────────────────────────

# Solidity parser sidecar endpoint (default: http://127.0.0.1:8003).
SIDECAR_URL=

# Background queue worker count (default: 3).
TASK_WORKERS=

# Repo monitoring loop interval in seconds (default: 3600).
MONITOR_INTERVAL_SECONDS=

# Max request body size in bytes (default: 5 MB).
MAX_REQUEST_BODY_BYTES=

# Reranker model for RAG (default: cross-encoder/ms-marco-MiniLM-L-6-v2).
RERANKER_MODEL=

# SMTP for email sending.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Frontend (set at Vercel build time) ─────────────────────────────────────

# Public backend URL the React frontend points at (no trailing slash).
REACT_APP_API_BASE=https://ak001z-gitmind-backend.hf.space
