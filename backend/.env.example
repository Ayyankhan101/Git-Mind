GROQ_API_KEY=gsk_...
# GITHUB_TOKEN=ghp_...   (optional — raises GitHub API rate limit 60→5000 req/hr)
# WS_AUTH_SECRET=...      (optional — if set, WS clients must send matching ws_auth_secret in payload)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://your-app.vercel.app   (default: covers all localhost; add Vercel domain in production)
# DATABASE_URL=sqlite+aiosqlite:///./gitmind.db   (default — SQLite for local dev)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/gitmind   (production)
